# Copy this file to .env.local for local development, and add the same values
# in Vercel: Project > Settings > Environment Variables.

# Supabase: Project URL from the "Connect" button at the top of your project;
# keys from Project Settings > API Keys (publishable key -> ANON_KEY, secret key -> SERVICE_ROLE_KEY)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio: https://aistudio.google.com/apikey (free tier, no card needed)
GEMINI_API_KEY=
# Optional: another free-tier model if Google renames this one
# GEMINI_MODEL=gemini-3.5-flash-lite

# Only these emails may use the AI (comma separated). Leave empty to allow any signed-in user.
ALLOWED_EMAILS=

# Web push keys: run `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Any long random string; Vercel sends it to the daily reminder job
CRON_SECRET=

# Time zone that decides "today" for reminders
APP_TIME_ZONE=Europe/Amsterdam
